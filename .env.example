# Gemini API Key (Get it from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Neon PostgreSQL Database Connection URL (e.g. postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# App Base URL (Used for generating permanent QR code and review links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication Keys (Get it from https://clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
