generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  placeId         String
  category        String
  city            String
  keywords        String
  googleReviewUrl String?
  customPrompt    String?
  geminiApiKey    String?
  minRatingForRedirect Int @default(4)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  reviewLogs      ReviewLog[]

  @@index([slug])
  @@index([placeId])
}

model ReviewLog {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rating         Int
  language       String
  selectedReview String?  @db.Text
  copied         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([businessId])
}

model MenuBusiness {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  city        String
  description String?
  phone       String?
  menuImages  String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model ContactBusiness {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  city        String
  whatsappNo  String?
  instagramId String?
  facebookId  String?
  youtubeId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

